# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and publishable key (sb_publishable_...). Both are
# shipped to the browser by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of this deployment, no trailing slash. Server-only; used as
# metadataBase to make the Open Graph image URL absolute. Locally:
# http://localhost:3000
SITE_URL=

# Private beta: the invite code signup requires (lib/auth/inviteCode.ts).
# Server-only -- never give it a NEXT_PUBLIC_ prefix, which would publish it
# in the client bundle. Unset or blank, every signup is rejected.
SORREL_INVITE_CODE=
